# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every variable is validated at startup (src/shared/config/env.ts);
# the process refuses to boot if anything is missing or malformed.
# Never commit .env.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (docker compose `db` service) ----------------------------------
DATABASE_URL=postgresql://ggi:ggi_dev_password@localhost:5440/ggi?schema=public
# Used by the integration test suite (docker compose `db-test` service)
TEST_DATABASE_URL=postgresql://ggi:ggi_test_password@localhost:5441/ggi_test?schema=public

# --- Auth (external OIDC provider, e.g. Auth0) ------------------------------
# Issuer must match the token `iss` claim exactly (Auth0 includes the trailing slash).
AUTH_ISSUER=https://YOUR_TENANT.us.auth0.com/
# API identifier configured in Auth0 (token `aud`; Auth0 sends it as an array).
AUTH_AUDIENCE=https://your-api-identifier
AUTH_JWKS_URI=https://YOUR_TENANT.us.auth0.com/.well-known/jwks.json
# Namespaced custom claim carrying the user's roles (set by an Auth0 Action).
AUTH_ROLES_CLAIM=https://your-api-identifier/roles

# --- Replay protection (X-Request-Timestamp / X-Request-Nonce) -------------
REPLAY_WINDOW_SECONDS=300

# --- HTTP hardening ----------------------------------------------------------
# Comma-separated allowlist of browser origins. No wildcard allowed.
CORS_ORIGINS=http://localhost:5173
# Express `trust proxy`: false | true | <number of hops> (use 1 behind a single LB).
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=10000

# --- Rate limits (requests per window) --------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_PER_IP=300
RATE_LIMIT_AUTH_PER_IP=10
RATE_LIMIT_AUTH_PER_USER=5
RATE_LIMIT_CHAT_PER_IP=60
RATE_LIMIT_CHAT_PER_USER=20
RATE_LIMIT_SUBSCRIPTIONS_PER_IP=60
RATE_LIMIT_SUBSCRIPTIONS_PER_USER=30

# --- Mock LLM ----------------------------------------------------------------
LLM_MIN_LATENCY_MS=300
LLM_MAX_LATENCY_MS=1500
LLM_TIMEOUT_MS=5000

# --- Billing simulation ------------------------------------------------------
# probability [0..1] that a mock payment fails
PAYMENT_FAILURE_RATE=0.2
# renewal job schedule (node-cron syntax)
RENEWAL_CRON="* * * * *"
RENEWAL_BATCH_SIZE=50
# purge expired replay nonces
NONCE_CLEANUP_CRON="*/5 * * * *"
